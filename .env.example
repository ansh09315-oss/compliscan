# ==============================================================================
# CompliScan AI - Environment Variables Template
# Copy this file to .env (local dev) or set in Cloud Dashboards:
#   - Frontend (Netlify): Site Settings > Environment Variables
#   - Backend (Hugging Face Spaces / Render): Settings > Variables and Secrets
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Gemini API (VLM Semantic Brain — Path A)
# Obtain from: https://aistudio.google.com/app/apikey
# Set in backend environment (HF Spaces secret or Render env var)
# ------------------------------------------------------------------------------
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"

# ------------------------------------------------------------------------------
# 2. Supabase (PostgreSQL Database & Judicial Dossier Audit Trail)
# Obtain from: https://supabase.com/dashboard > Project Settings > API
# Set in: BOTH Netlify (frontend) and HF Spaces / Render (backend)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here"

# Backend uses service role key for elevated DB access (server-side only — NEVER expose publicly)
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here"
SUPABASE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here"

# ------------------------------------------------------------------------------
# 3. Backend Microservice Endpoint
# Used by Next.js frontend to dispatch 4-angle packaging scans & export reports.
# Set in: Netlify Environment Variables
# Local:      http://localhost:8000
# Production: https://compliscan-backend.hf.space  (or your Render URL)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_BACKEND_URL="https://compliscan-backend.hf.space"

# ------------------------------------------------------------------------------
# 4. CORS Configuration (Backend only — set on HF Spaces / Render)
# Comma-separated list of allowed frontend origins.
# The backend already includes compliscan.netlify.app as a static fallback.
# ------------------------------------------------------------------------------
ALLOWED_ORIGINS="https://compliscan.netlify.app"

# ------------------------------------------------------------------------------
# 5. Production App URL (for canonical SEO links in Next.js)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="https://compliscan.netlify.app"

# ------------------------------------------------------------------------------
# 6. Hugging Face Spaces / Docker Runtime (Backend) — usually auto-set
# ------------------------------------------------------------------------------
PORT=7860
HOST="0.0.0.0"
PROTOCOL_BUFFERS_PYTHON_IMPLEMENTATION="python"
FLAGS_use_mkldnn="0"

# ------------------------------------------------------------------------------
# 7. Local Database (Prisma SQLite — offline-first development only)
# ------------------------------------------------------------------------------
DATABASE_URL="file:./dev.db"
