# ==============================================================================
# CompliScan (SIH 26034) - Environment Variables Template
# Copy this file to .env (for local development) or set in Cloud Dashboards:
#   - Frontend (Netlify): Site Settings > Environment Variables
#   - Backend (Hugging Face Spaces): Settings > Variables and Secrets
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Gemini API (Path A: Multi-Angle Semantic Brain)
# Obtain from Google AI Studio: https://aistudio.google.com/app/apikey
# Required in: Hugging Face Spaces Backend (Repository Secret: GEMINI_API_KEY)
# ------------------------------------------------------------------------------
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"

# ------------------------------------------------------------------------------
# 2. Supabase Cloud (PostgreSQL Database & Judicial Dossier Audit Trail)
# Obtain from Supabase Project Settings > API: https://supabase.com/dashboard
# Required in: Both Netlify (Frontend) and Hugging Face Spaces (Backend)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here"

# Backend direct Supabase configuration (optional fallback for non-Next environments)
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here"

# ------------------------------------------------------------------------------
# 3. Backend Microservice Endpoint
# Used by Next.js frontend to dispatch 4-angle packaging scans & export reports
# Required in: Netlify (Frontend)
# Local: http://localhost:8000
# Production: https://YOUR_HF_USERNAME-compliscan-backend.hf.space
# ------------------------------------------------------------------------------
NEXT_PUBLIC_BACKEND_URL="https://your-huggingface-space-name.hf.space"

# ------------------------------------------------------------------------------
# 4. Hugging Face Spaces / Docker Runtime Configuration (Backend)
# Default values already baked into Dockerfile (override only if necessary)
# ------------------------------------------------------------------------------
PORT=7860
HOST="0.0.0.0"
PROTOCOL_BUFFERS_PYTHON_IMPLEMENTATION="python"
FLAGS_use_mkldnn="0"

# ------------------------------------------------------------------------------
# 5. Local Database (Optional Prisma SQLite for offline testing)
# ------------------------------------------------------------------------------
DATABASE_URL="file:./dev.db"
